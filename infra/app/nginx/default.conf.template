# ${DOMAIN}, ${OPS_IP} 는 컨테이너 시작 시 .env 값으로 치환됨 (nginx 공식 이미지 기능)

# IP당 동시 연결, 요청 속도 제한 (앱의 IP당 20개 제한보다 앞에서 먼저 거름)
limit_conn_zone $binary_remote_addr zone=perip:10m;
limit_req_zone  $binary_remote_addr zone=reqs:10m rate=10r/s;
# 관리자 페이지: 비밀번호 대입을 늦추려고 IP당 초당 2회
limit_req_zone  $binary_remote_addr zone=admin:1m rate=2r/s;
# 이용 통계 beacon(/api/track): 페이지를 닫을 때 한 번씩이라 IP당 초당 2회면 충분
limit_req_zone  $binary_remote_addr zone=track:10m rate=2r/s;
# 위즈파크 임시 중계: 학교나 통신사 NAT 뒤의 여러 사람이 같은 IP로 보여도 막히지 않게 넉넉히
limit_req_zone  $binary_remote_addr zone=wiz:10m rate=30r/s;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name ${DOMAIN};

  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  location /ws {
    limit_conn perip 20;
    limit_req  zone=reqs burst=20 nodelay;

    proxy_pass http://realtime-server:8080;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    # Spring은 이 헤더로 실제 클라이언트 IP를 읽어야 함 (안 그러면 모두 Nginx IP로 보임)
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;   # 클라이언트 ping이 10초라 여유 있음
  }

  # 이용 통계 beacon (docs/analytics.md). 본문은 작은 JSON 하나라 4KB면 충분
  location = /api/track {
    limit_req zone=track burst=10 nodelay;
    limit_except POST { deny all; }
    client_max_body_size 8k;
    proxy_pass http://realtime-server:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  # Spring 지표: ops 서버에서만
  location /actuator/prometheus {
    allow ${OPS_IP};
    deny all;
    proxy_pass http://realtime-server:8080;
  }

  # 관리자 페이지 https://${DOMAIN}/admin
  # 로그인(HTTP Basic)과 IP당 5회 실패 시 10분 차단은 Spring(AdminAuthFilter)이 함.
  # 여기서는 TLS와 요청 속도 제한만. 고정 IP에서만 쓴다면 allow <내 IP>; deny all; 을 추가
  location /admin {
    limit_req zone=admin burst=20 nodelay;

    proxy_pass http://realtime-server:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  # 한국시리즈 임시 중계 파일 (infra/app/wiz-relay). Spring을 거치지 않는 정적 파일
  # 위즈파크 접속자 위치 (infra/app/wiz-relay/presence.mjs)
  location = /wiz/ws {
    limit_conn perip 30;
    proxy_pass http://wiz-presence:8090;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 90s;
  }

  # 위즈파크 응원가 목록과 관리자 페이지 (로그인은 presence.mjs)
  location = /wiz/cheers.json {
    limit_req zone=wiz burst=60 nodelay;
    limit_except GET { deny all; }
    alias /srv/wiz/cheers.json;
    default_type application/json;
    add_header Cache-Control "no-cache" always;
    add_header Access-Control-Allow-Origin "*" always;
  }

  # 위즈파크 익명 방문 집계. IP는 presence.mjs에 넘기지 않는다
  location = /wiz/hit {
    limit_req zone=wiz burst=60 nodelay;
    limit_except GET { deny all; }
    access_log off;
    add_header Access-Control-Allow-Origin "*" always;
    proxy_pass http://wiz-presence:8090;
  }

  location /wiz/admin {
    limit_req zone=admin burst=20 nodelay;
    proxy_pass http://wiz-presence:8090;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
  }

  # 위즈파크 경기 재연 기록. 지금은 ?demo=1 에서만 읽는다
  location = /wiz/replay.json {
    limit_req zone=wiz burst=60 nodelay;
    limit_except GET { deny all; }
    alias /srv/wiz/replay.json;
    default_type application/json;
    gzip on;
    gzip_types application/json;
    gzip_min_length 256;
    add_header Cache-Control "no-cache" always;
    add_header Access-Control-Allow-Origin "*" always;
  }

  location = /wiz/state.json {
    limit_req zone=wiz burst=60 nodelay;
    limit_except GET { deny all; }
    alias /srv/wiz/state.json;
    default_type application/json;
    gzip on;
    gzip_types application/json;
    gzip_min_length 256;
    add_header Cache-Control "no-cache" always;
    add_header Access-Control-Allow-Origin "*" always;
  }

  location / { return 404; }
}
