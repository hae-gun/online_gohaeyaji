# cp .env.example .env 후 채우기 (.env는 git에 올리지 않음)
DOMAIN=api.example.com
CERT_EMAIL=you@example.com
# Prometheus가 지표를 가져갈 ops 서버의 공인 IP
OPS_IP=0.0.0.0
# 앵로그 주소 (앵로그 infra/README의 순서대로: 인증서를 먼저 받은 뒤 넣는다)
ANGLOG_DOMAIN=api.anglog.example.com
# 몇 대 몇? API 주소 (README 2-1-2 순서대로: 인증서를 먼저 받은 뒤 넣는다)
WHOSE_FAULT_DOMAIN=api.whose-fault.example.com
